{
    "manifest_version": 3,
    "name": "Job Conversation Extractor",
    "version": "0.1.0",
    "description": "Extract job conversation text from recruitment websites.",
  
    "permissions": [
      "activeTab",
      "scripting",
      "clipboardWrite",
      "storage"
    ],

    "host_permissions": [
      "https://api.openai.com/*",
      "https://api.anthropic.com/*",
      "https://api.deepseek.com/*"
    ],

    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ],

    "background": {
      "service_worker": "background.js"
    },
  
    "icons": {
      "128": "icon.png"
    },
  
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    }
  }
